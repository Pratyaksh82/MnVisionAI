# ==============================================================================
# MnVisionAI: Environment Configuration for Render & Production
# ==============================================================================

# [RECOMMENDED ON RENDER] Runtime Versions
# Setting Python 3.11.9 ensures fast builds with pre-compiled wheels for NumPy & SciPy
PYTHON_VERSION=3.11.9
NODE_VERSION=20.14.0

# [AUTOMATICALLY MANAGED BY RENDER]
# Render assigns PORT dynamically (e.g. 10000). Leave blank or unset in Render dashboard.
PORT=8000

# [OPTIONAL] API Base Route Override
# By default, MnVisionAI automatically uses relative routes in production ('')
# and http://127.0.0.1:8000 on localhost. No change needed.
# VITE_API_BASE=
